<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Theme.EpubReader.Dark" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/dark_primary</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorPrimaryContainer">@color/dark_details</item>
        <item name="colorOnPrimaryContainer">@color/dark_text</item>
        <item name="colorSecondary">@color/dark_details</item>
        <item name="colorOnSecondary">@color/dark_text</item>
        <item name="colorSurface">@color/dark_toolbar</item>
        <item name="colorOnSurface">@color/dark_text</item>
        <item name="colorSurfaceVariant">@color/dark_toolbar</item>
        <item name="colorOnSurfaceVariant">@color/dark_text</item>
        <item name="android:colorBackground">@color/dark_background</item>
        <item name="colorOnBackground">@color/dark_text</item>
        <item name="android:statusBarColor">@color/dark_toolbar</item>
        <item name="android:navigationBarColor">@color/dark_toolbar</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>

    <style name="Theme.EpubReader.Light" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/light_primary</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorPrimaryContainer">@color/light_details</item>
        <item name="colorOnPrimaryContainer">@color/light_text</item>
        <item name="colorSecondary">@color/light_details</item>
        <item name="colorOnSecondary">@color/light_text</item>
        <item name="colorSurface">@color/light_toolbar</item>
        <item name="colorOnSurface">@color/light_text</item>
        <item name="colorSurfaceVariant">@color/light_toolbar</item>
        <item name="colorOnSurfaceVariant">@color/light_text</item>
        <item name="android:colorBackground">@color/light_background</item>
        <item name="colorOnBackground">@color/light_text</item>
        <item name="android:statusBarColor">@color/light_toolbar</item>
        <item name="android:navigationBarColor">@color/light_toolbar</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>

    <!-- Tema padrão aponta para Dark -->
    <style name="Theme.EpubReader" parent="Theme.EpubReader.Dark"/>

</resources>